# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.iml
*.swp

# Env files (never commit real secrets)
.env
.env.*
!.env.example

# ---- Flutter (viewer_app/) ----
# Most rules already exist in viewer_app/.gitignore.
# Keep the platform folders — they're generated but iOS/Android need to
# check in for release signing config.
viewer_app/.dart_tool/
viewer_app/.flutter-plugins
viewer_app/.flutter-plugins-dependencies
viewer_app/build/
viewer_app/ios/Pods/
viewer_app/ios/.symlinks/
viewer_app/ios/Flutter/Flutter.podspec
viewer_app/ios/Flutter/ephemeral/
viewer_app/macos/Pods/
viewer_app/macos/Flutter/ephemeral/
viewer_app/linux/flutter/ephemeral/
viewer_app/windows/flutter/ephemeral/

# ---- Next.js (admin_panel/) ----
admin_panel/node_modules/
admin_panel/.next/
admin_panel/out/
admin_panel/.turbo/
admin_panel/.vercel/
admin_panel/*.tsbuildinfo

# ---- Gradle / Spring Boot (backend/) ----
backend/.gradle/
backend/build/
backend/out/
backend/bin/
backend/HELP.md
