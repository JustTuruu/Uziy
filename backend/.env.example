# Copy to .env (git-ignored); ./gradlew bootRun loads it. Tests never read it.
# simulated = no SMS; a check stays pending until the curl the backend logs "delivers" it (dev). verifymn = real verify.mn.
PHONE_VERIFICATION_PROVIDER=simulated
# verify.mn Developer Console → API key. Required when the provider is verifymn.
VERIFY_MN_API_KEY=
# Random per machine: openssl rand -base64 64. Without it the committed dev secret is used, and anyone who can
# reach the backend could sign their own admin token.
# JWT_SECRET=<paste the random value here>
